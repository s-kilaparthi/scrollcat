    <color name="scrollcat_outline">#8C7A68</color>
    <color name="scrollcat_primary">#D97706</color>
    <color name="scrollcat_primary_container">#FFE0B2</color>
    <color name="scrollcat_secondary">#0F766E</color>
    <color name="scrollcat_secondary_container">#CCFBF1</color>
    <color name="scrollcat_surface">#FFF8F0</color>
    <color name="scrollcat_surface_variant">#F2E4D4</color>
    <string name="accessibility_service_description">Lets the ScrollCat companion perform scroll gestures on your behalf when you flick the cat, reducing repeated thumb swipes.</string>
