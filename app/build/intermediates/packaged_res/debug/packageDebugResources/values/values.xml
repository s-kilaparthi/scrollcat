<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="scrollcat_on_primary">#FFFFFF</color>
    <color name="scrollcat_on_primary_container">#3F2200</color>
    <color name="scrollcat_on_secondary">#FFFFFF</color>
