<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Claude API (Pro tier) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility (API 30+): allow icon/label lookups for messaging apps -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.instagram.android" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.twitter.android" />
        <package android:name="com.linkedin.android" />
        <package android:name="com.microsoft.teams" />
        <package android:name="us.zoom.videomeetings" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="com.slack" />
        <package android:name="com.discord" />
        <package android:name="com.microsoft.office.outlook" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.samsung.android.messaging" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.android.mms" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ScrollCat">

        <!-- Required for LiteRT-LM / GPU OpenCL access on API 31+ -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL-car.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL-pixel.so"
            android:required="false" />

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true">
        </activity>

        <activity
            android:name=".NotificationSettingsActivity"
            android:exported="false"
            android:label="Notification Settings"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings" />

        <activity
            android:name=".AiProviderActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AiSettingsActivity"
            android:exported="false"
            android:label="My AI Settings"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AutoReplyActivity"
            android:exported="false"
            android:label="Auto-Reply Rules"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SmartVoiceActivity"
            android:exported="false"
            android:label="Smart Voice"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AutoReplyTrackerActivity"
            android:exported="false"
            android:label="Auto Reply Tracker" />

        <activity
            android:name=".FeedbackActivity"
            android:exported="false"
            android:label="Give Feedback"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:label="Welcome to ScrollCat"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SubscriptionActivity"
            android:exported="false"
            android:label="ScrollCat Pro" />

        <activity
            android:name=".PrivacyPolicyActivity"
            android:exported="false"
            android:label="Privacy Policy" />

        <activity
            android:name=".ShareCardActivity"
            android:exported="false"
            android:label="Share My Stats" />

        <activity
            android:name=".RecordAudioPermissionActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- The floating cat overlay -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating companion overlay that the user interacts with" />
        </service>

        <!-- Temporary LiteRT-LM feasibility test — delete with TestLlmService.kt -->
        <service
            android:name=".TestLlmService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Temporary on-device LLM feasibility test only" />
        </service>

        <!-- The gesture injector. permission + meta-data are BOTH required
             or the service silently won't appear in Accessibility settings -->
        <service
            android:name=".CatAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".CatNotificationListener"
            android:exported="false"
            android:label="ScrollCat Notification Reader"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
